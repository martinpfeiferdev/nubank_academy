# Environment variables configuration example
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials to version control

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/your-project/keys/
SENTRY_DSN=your-sentry-dsn-here

# Firebase Configuration
# These values come from your google-services.json file
# Keep google-services.json out of version control in production
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key

# User Authentication
# These IDs should come from Firebase Authentication
# DO NOT hardcode user IDs in your code
USER_ID=should-be-retrieved-from-firebase-auth
ACCOUNT_ID=should-be-retrieved-from-firebase-auth

# Build Configuration
# Keystore for release builds (keep these secure!)
KEYSTORE_FILE=path/to/your/release-key.jks
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=your-key-alias
KEY_PASSWORD=your-key-password
